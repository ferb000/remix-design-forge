DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/design_forge
PORT=3002
PUBLIC_API_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@designforge.com
ADMIN_PASSWORD=forge2026!
ADMIN_NAME=Studio Director
STORAGE_DRIVER=local
# Production S3/CloudFront configuration is in deploy/vps/api.env.example.
# Use a separate empty database when running integration tests.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/design_forge_test

# Set true and fill these in to send booking/inquiry confirmation emails.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=hello@example.com
SMTP_FROM_NAME=Design Forge
SMTP_REPLY_TO=hello@example.com
