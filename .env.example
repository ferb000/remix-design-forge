# Copy to .env in the repository root for Docker Compose production deployment.
# Runtime secrets: never commit .env or put these values in VITE_* variables.
DOMAIN=studio.example.com
CERT_EMAIL=you@example.com
ADMIN_EMAIL=designforge25@gmail.com
ADMIN_NAME=Studio Director
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
AWS_REGION=eu-west-1
S3_BUCKET=YOUR_PRIVATE_BUCKET
# EC2 instance role: leave AWS access keys empty (IMDSv2 hop limit must be 2).
# Other VPS: use the restricted IAM user's credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=designforge25@gmail.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=hello@example.com
SMTP_FROM_NAME=Design Forge
SMTP_REPLY_TO=hello@example.com
